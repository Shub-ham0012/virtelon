{
  "name": "virtelon-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @virtelon/db exec prisma generate",
    "db:migrate": "pnpm --filter @virtelon/db exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @virtelon/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @virtelon/db exec tsx src/seed.ts",
    "db:studio": "pnpm --filter @virtelon/db exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
