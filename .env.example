# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://virtelon:virtelon@localhost:5432/virtelon_dev"

# ─── Auth ────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# ─── Redis (queues, rate limiting) — required from Phase 7 onward ──
REDIS_URL="redis://localhost:6379"

# ─── Object storage — required from Phase 3 onward (audit screenshots) ──
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── AI provider — required from Phase 4 onward ─────────────
ANTHROPIC_API_KEY=""

# ─── Lead discovery — required from Phase 2 onward ──────────
GOOGLE_PLACES_API_KEY=""

# ─── Online presence research — required from Phase 3 onward ──
# Used only to find public Instagram/Facebook/etc profile URLs via an
# official search API — never to scrape those platforms directly.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

# ─── Outreach providers — required from Phase 6 onward ──────
RESEND_API_KEY=""
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_APP_SECRET=""

# ─── Secret encryption — required from Phase 6 onward ───────
# AES-256-GCM key for Integration.encryptedCredentials / OutreachAccount.encryptedCredentials
CREDENTIALS_ENCRYPTION_KEY="generate-with: openssl rand -hex 32"

NODE_ENV="development"
